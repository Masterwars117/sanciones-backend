{
  "name": "sanciones-backend",
  "dockerComposeFile": ["../docker/dev/docker-compose.yml", "docker-compose.yml"],
  "service": "django",
  "workspaceFolder": "/workspaces",
  "overrideCommand": false,
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Sancionados API",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "python manage.py migrate --noinput && python manage.py runserver 0.0.0.0:8000",
  "customizations": {
    "vscode": {
      "settings": {
        "[python]": {
          "editor.formatOnType": true,
          "editor.defaultFormatter": "ms-python.black-formatter"
        },
        "github.copilot.chat.localeOverride": "es"
      },
      "extensions": [
        "ms-python.python",
        "KevinRose.vsc-python-indent",
        "njpwerner.autodocstring",
        "VisualStudioExptTeam.vscodeintellicode",
        "batisteo.vscode-django",
        "ms-python.autopep8",
        "ms-python.black-formatter",
        "shamanu4.django-intellisense",
        "frhtylcn.pythonsnippets",
        "ms-python.debugpy",
        "ms-python.vscode-pylance",
        "ms-python.isort",
        "charliermarsh.ruff",
        "esbenp.prettier-vscode",
        "christian-kohler.path-intellisense",
        "PKief.material-icon-theme",
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers",
        "ms-azuretools.vscode-containers"
      ]
    }
  }
}
